# Chave do agente NVIDIA — habilita "Gerar cenários" com IA no Audi Print.
# Obtenha em: https://build.nvidia.com
# Nunca committe este arquivo com a chave real.
AGENTE_API_KEY=nvapi-sua-chave-aqui

# Endpoint OpenAI-compatible da NVIDIA (padrão)
AGENTE_BASE_URL=https://integrate.api.nvidia.com/v1

# Modelo com visão (padrão: 11B — responde rápido no catálogo NVIDIA)
AGENTE_MODELO=meta/llama-3.2-11b-vision-instruct
# AGENTE_MODELO=meta/llama-3.2-90b-vision-instruct

# Opcional — teto de imagens por geracao
# AGENTE_MAX_IMAGENS=20

# Opcional — teto de tokens de saida
# AGENTE_MAX_TOKENS=4096
