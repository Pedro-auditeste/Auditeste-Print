# Variaveis do Audi Print.
#
# NUNCA committe este arquivo com valor real. Aqui so ficam os NOMES e como
# gerar cada um. Os valores vivem na Railway (aba Variables) ou num .env local
# que o .gitignore ja bloqueia.
#
# Para gerar um valor aleatorio, rode no terminal e copie o RESULTADO
# (a saida de 64 caracteres), nao o comando:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Erro comum: colar o proprio comando dentro da variavel. O sistema aceita e
# nao reclama, mas a chave passa a ser um texto publico, e ai a cifra nao
# protege de ninguem.

# ---------- agente (descricao das telas) ----------

# Chave NVIDIA. Obtenha em https://build.nvidia.com -> API Keys -> Generate.
# Comeca com nvapi-. Se vazar, revogue e gere outra.
AGENTE_API_KEY=nvapi-sua-chave-aqui

AGENTE_BASE_URL=https://integrate.api.nvidia.com/v1

# Modelo com visao. O 11B responde rapido; o 90B costuma estourar o tempo.
AGENTE_MODELO=meta/llama-3.2-11b-vision-instruct
AGENTE_MODELO_FALLBACK=meta/llama-3.2-11b-vision-instruct

# Opcionais
# AGENTE_TIMEOUT_MS=90000
# AGENTE_MAX_IMAGENS=0
# AGENTE_MAX_TOKENS=2048

# ---------- cofre de evidencias ----------

# Cifra do conteudo em repouso (AES-256-GCM). Hex de 64 caracteres.
#
# ATENCAO: TROCAR ESTE VALOR TORNA ILEGIVEL TUDO QUE JA FOI GRAVADO CIFRADO.
# Perder a chave e perder os prints, e e isso que faz cifra ser cifra.
# Guarde uma copia FORA do lugar onde fica o backup.
COFRE_CHAVE=

# Assina os links temporarios de acesso ao arquivo. Hex de 64 caracteres.
# Sem ele, o sistema sorteia um a cada subida: os links de 5 minutos param de
# valer a cada redeploy. Nada se perde, mas link aberto na hora do deploy cai.
COFRE_SEGREDO=

# Caminho do banco. Na Railway TEM que apontar para um volume montado,
# senao o proximo deploy apaga a evidencia. Deixe vazio para o sistema
# detectar /dados ou /data sozinho.
# COFRE_BANCO=/dados/cofre.db

# Duracao da sessao em milissegundos (padrao 12 h)
# COFRE_SESSAO_MS=43200000

# ---------- ponte (o Print falando com o servidor) ----------

# Token exigido nas chamadas de scan. Hex de 64 caracteres.
PONTE_TOKEN=

# Origens liberadas no CORS, separadas por virgula, SEM barra no fim.
#
# ATENCAO: tem de ser a URL DESTE servico. Apontar para a URL de outro
# ambiente faz o navegador bloquear toda chamada com "Access-Control-Allow-
# Origin: null", e o sistema parece quebrado sem erro claro na tela.
#
# Exemplo com dois ambientes:
# PONTE_ORIGENS=https://audi-print-production.up.railway.app,https://audiprint.up.railway.app
PONTE_ORIGENS=

# Quantos proxies confiaveis existem na frente (Railway = 1)
# PONTE_PROXIES=1
