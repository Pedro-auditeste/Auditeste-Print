# Chave da Anthropic — habilita "Gerar com IA" no Audi Print.
# Obtenha em: https://console.anthropic.com/
# Nunca committe este arquivo com a chave real.
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

