# Chave do agente NVIDIA — habilita descrição dos prints e "Gerar cenários".
# Obtenha em: https://build.nvidia.com
# Nunca committe este arquivo com a chave real.
AGENTE_API_KEY=nvapi-sua-chave-aqui

# Endpoint oficial NVIDIA (chat/completions)
AGENTE_BASE_URL=https://integrate.api.nvidia.com/v1

# Modelo com visão (o 90B é o do catálogo NVIDIA; se atrasar, cai no 11B)
AGENTE_MODELO=meta/llama-3.2-90b-vision-instruct
AGENTE_MODELO_FALLBACK=meta/llama-3.2-11b-vision-instruct

# Opcional
# AGENTE_TIMEOUT_MS=45000
# AGENTE_MAX_IMAGENS=20
# AGENTE_MAX_TOKENS=4096
