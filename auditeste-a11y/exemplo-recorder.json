{
  "title": "Comprar na loja",
  "steps": [
    {
      "type": "setViewport",
      "width": 1366,
      "height": 768,
      "deviceScaleFactor": 1,
      "isMobile": false,
      "hasTouch": false,
      "isLandscape": false
    },
    {
      "type": "navigate",
      "url": "https://www.casasbahia.com.br/",
      "assertedEvents": [
        {
          "type": "navigation",
          "url": "https://www.casasbahia.com.br/",
          "title": "Casas Bahia"
        }
      ]
    },
    {
      "type": "click",
      "target": "main",
      "selectors": [
        ["#search-input"],
        ["xpath///*[@id=\"search-input\"]"],
        ["pierce/#search-input"],
        ["aria/Pesquisar"]
      ],
      "offsetY": 18,
      "offsetX": 120
    },
    {
      "type": "change",
      "value": "geladeira",
      "selectors": [
        ["#search-input"],
        ["xpath///*[@id=\"search-input\"]"],
        ["aria/Pesquisar"]
      ],
      "target": "main"
    },
    {
      "type": "keyDown",
      "target": "main",
      "key": "Enter"
    },
    {
      "type": "keyUp",
      "key": "Enter",
      "target": "main"
    },
    {
      "type": "scroll",
      "target": "main",
      "x": 0,
      "y": 600
    },
    {
      "type": "click",
      "target": "main",
      "selectors": [
        ["[data-testid=\"card-produto-1\"]"],
        ["xpath///*[@data-testid=\"card-produto-1\"]"],
        ["text/Geladeira Consul"]
      ],
      "offsetY": 40,
      "offsetX": 90,
      "assertedEvents": [
        {
          "type": "navigation",
          "url": "https://www.casasbahia.com.br/geladeira-consul/p/55069668",
          "title": "Geladeira Consul Cycle Defrost"
        }
      ]
    },
    {
      "type": "click",
      "target": "main",
      "selectors": [
        ["button.btn-comprar"],
        ["xpath//html/body/div[1]/main/button"],
        ["text/Comprar"]
      ],
      "offsetY": 22,
      "offsetX": 60
    }
  ]
}
