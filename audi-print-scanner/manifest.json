{
  "manifest_version": 3,
  "name": "Audi Print · Captura de evidências de teste",
  "version": "2.2.1",
  "description": "Registra cada interação do teste com o xpath do elemento e o print antes/depois, e roda o scan de acessibilidade.",
  "homepage_url": "https://audiprint.up.railway.app",
  "permissions": ["scripting", "downloads", "storage", "tabs", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "action": {
    "default_title": "Audi Print",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    }
  }
}
